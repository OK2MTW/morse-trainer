# Pinggy tunnel for public access (installed by deploy/pinggy-setup.sh, @USER@/@DIR@/@HOME@ filled in on installation).
#   sudo systemctl enable --now morse-pinggy   = zapnout (i po restartu Pi)
#   sudo systemctl stop morse-pinggy           = immediate disconnect from outside (disable = also after a reboot of the Pi)
# The token is in /etc/morse-trainer/pinggy.env (root, 600), not in git. Login is protected by the app (E3), not by a tunnel password.
[Unit]
Description=Morse trenazer - Pinggy tunel (verejny pristup)
After=network-online.target nginx.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=@USER@
EnvironmentFile=/etc/morse-trainer/pinggy.env
ExecStart=/usr/bin/ssh -p 443 -t -R0:127.0.0.1:8090 \
    -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes \
    -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=@HOME@/.ssh/known_hosts_pinggy \
    ${PINGGY_TOKEN}@pro.pinggy.io x:https x:xff
Restart=always
RestartSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HOME@/.ssh
MemoryMax=30M

[Install]
WantedBy=multi-user.target
