# SPDX-License-Identifier: EUPL-1.2
# Adresy této instalace → /etc/morse-trainer/site.env (deploy/install.sh ho vytvoří s odhadnutými hodnotami).
# Soubor není tajný (jen adresy). Tajné údaje (token Pinggy) patří do /etc/morse-trainer/pinggy.env.
# Po změně: sudo deploy/install.sh (a pro veřejný vstup sudo deploy/pinggy-setup.sh).

# Adresa v domácí síti (IP adresa Raspberry Pi)
MORSE_HOME_URL=https://192.168.0.10/
# Domácí síť, ze které je aplikace dostupná (firewall, omezení domácí CA)
MORSE_LAN=192.168.0.0/24
# Veřejná adresa přes Pinggy (trvalá subdoména z dashboard.pinggy.io); prázdné = jen domácí síť
MORSE_PUBLIC_URL=
