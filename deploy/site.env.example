# SPDX-License-Identifier: EUPL-1.2
# Addresses of this installation → /etc/morse-trainer/site.env (deploy/install.sh creates it with estimated values).
# The file is not secret (addresses only). Secrets (the Pinggy token) belong to /etc/morse-trainer/pinggy.env.
# After a change: sudo deploy/install.sh (and for the public entry sudo deploy/pinggy-setup.sh).

# Address in the home network (IP address of the Raspberry Pi)
MORSE_HOME_URL=https://192.168.0.10/
# Home network from which the app is reachable (firewall, restriction of the home CA)
MORSE_LAN=192.168.0.0/24
# Public address via Pinggy (permanent subdomain from dashboard.pinggy.io); empty = home network only
MORSE_PUBLIC_URL=
